# ==================== BASE DE DATOS ====================
# PostgreSQL Configuration
DB_NAME=certificados_db
DB_USER=certificados_user
DB_PASSWORD=secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ==================== DJANGO ====================
# Generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here

# DEBUG: True para desarrollo, False para producción
DEBUG=True

# ==================== EMAIL CONFIGURATION (SendGrid) ====================
# SendGrid (API HTTPS) — recommended for Railway, Render, Heroku, etc.
# Free tier: 100 emails/day. Sign up at https://sendgrid.com
# Get your API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@certypro.app

# ==================== META WHATSAPP CLOUD API ====================
# Gratis hasta 1,000 mensajes/mes
# Obtener en: developers.facebook.com → Tu app → WhatsApp → Configuración de API

META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# ==================== GOOGLE OAUTH ====================
# Obtener Client ID en: Google Cloud Console → APIs & Services → Credentials
# Agregar URI de redireccion: http://localhost:3000 (desarrollo)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==================== CERTIFICADOS ====================
# Días hasta que un certificado expire
CERTIFICATE_EXPIRY_DAYS=365

# Habilitar verificación de certificados
CERTIFICATE_VERIFICATION_ENABLED=True

# ==================== PRODUCCIÓN (Opcional) ====================
# Descomentar estas líneas solo en producción

# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_SSL_REDIRECT=True

# ==================== RENDER.COM (auto-inyectadas) ====================
# Render inyecta DATABASE_URL automáticamente al ligar el Web Service a la BD.
# No es necesario setearla manualmente en Render.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# RENDER_EXTERNAL_HOSTNAME es inyectada por Render en el runtime.
# No configurar manualmente.

# ==================== REDIS / CELERY ====================
# Local: redis://localhost:6379/0
# Upstash (gratis en producción): rediss://...@...upstash.io:...
REDIS_URL=redis://localhost:6379/0

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
FRONTEND_URL=http://localhost:5173
