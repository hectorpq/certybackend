# ==================== BASE DE DATOS ====================
# PostgreSQL Configuration
DB_NAME=certificados_db
DB_USER=certificados_user
DB_PASSWORD=secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ==================== DJANGO ====================
# Generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here

# DEBUG: True para desarrollo, False para producción
DEBUG=True

# ==================== EMAIL CONFIGURATION (Resend API) ====================
# Resend (API HTTPS) — recommended for Railway, Render, Heroku, etc.
# Free tier: 100 emails/day. Sign up at https://resend.com
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ==================== META WHATSAPP CLOUD API ====================
# Gratis hasta 1,000 mensajes/mes
# Obtener en: developers.facebook.com → Tu app → WhatsApp → Configuración de API

META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# ==================== GOOGLE OAUTH ====================
# Obtener Client ID en: Google Cloud Console → APIs & Services → Credentials
# Agregar URI de redireccion: http://localhost:3000 (desarrollo)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==================== CERTIFICADOS ====================
# Días hasta que un certificado expire
CERTIFICATE_EXPIRY_DAYS=365

# Habilitar verificación de certificados
CERTIFICATE_VERIFICATION_ENABLED=True

# ==================== PRODUCCIÓN (Opcional) ====================
# Descomentar estas líneas solo en producción

# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_SSL_REDIRECT=True
